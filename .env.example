# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"
STOCK_API_KEY=

# Market-data provider selection. Keep "delayed" until a licensed gateway is configured.
MARKET_DATA_PROVIDER=delayed
MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER_NAME=

BREVO_API_KEY=

# Supabase server bindings. Secret/service-role keys never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_WAITLIST_TABLE=waitlist_leads
AUTH_ENABLED=false
SUPABASE_AUTH_ENABLED=false
SUPABASE_AUTH_REDIRECT_URL=https://stockpro1.qzz.io/account
ADMIN_ACCESS_TOKEN=
WAITLIST_ADMIN_ENABLED=false

# Browser Supabase access uses only a publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Trial billing foundation. Real checkout and charging remain disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_BILLING_EVENTS_TABLE=billing_events
SUPABASE_TRIAL_EVENTS_TABLE=trial_events
TRIAL_DAYS=7
PRO_PRICE_INR=299

# Per-user broker connection foundation. Never add a shared owner token.
BROKER_DATA_PROVIDER=none
BROKER_STREAM_ENABLED=false
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://stockpro1.qzz.io/api/broker/upstox/callback
DHAN_CLIENT_ID=
BROKER_TOKEN_STORAGE=supabase
BROKER_ENCRYPTION_SECRET=

DHAN_AFFILIATE_URL=
UPSTOX_AFFILIATE_URL=
ANGEL_AFFILIATE_URL=
ZERODHA_AFFILIATE_URL=
AFFILIATE_TRACKING_ENABLED=false
SUPABASE_AFFILIATE_CLICKS_TABLE=affiliate_clicks
SUPABASE_BETA_FEEDBACK_TABLE=beta_feedback

ADS_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_LEADERBOARD=
ADSENSE_SLOT_RECTANGLE=
ADSENSE_SLOT_IN_FEED=
SPONSOR_MODE=placeholder

# Optional client monitoring. Analytics stays off until explicitly enabled.
VITE_ANALYTICS_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Cloudflare Turnstile. The secret is server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# Search-only browser credentials; admin keys stay server-only.
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=
ALGOLIA_STOCK_INDEX=
ALGOLIA_CONTENT_INDEX=
