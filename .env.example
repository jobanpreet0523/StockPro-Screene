# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STOCK_API_KEY: Secure key for financial data provider.
STOCK_API_KEY=

# Market-data provider selection. Keep "delayed" until a licensed provider gateway is configured.
MARKET_DATA_PROVIDER=delayed
# Server-side only. The external adapter expects the StockPro-compatible gateway contract documented in docs/MARKET_DATA_PROVIDER.md.
MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER_NAME=

# BREVO_API_KEY: Secure key for Brevo Email Marketing API.
# Users configure this via the Secrets panel in the AI Studio UI.
BREVO_API_KEY=

# Server-only Supabase bindings for POST /api/waitlist.
# Configure these as Cloudflare Worker secrets/bindings. Never prefix the service-role key with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WAITLIST_TABLE=waitlist_leads
SUPABASE_AUTH_ENABLED=false
ADMIN_ACCESS_TOKEN=
WAITLIST_ADMIN_ENABLED=false

# Trial billing foundation. Server-side only; real checkout and charging remain disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_BILLING_EVENTS_TABLE=billing_events
TRIAL_DAYS=7
PRO_PRICE_INR=299

# Per-user broker connection foundation. Never add a shared owner access token.
BROKER_DATA_PROVIDER=none
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://stockpro1.qzz.io/api/broker/upstox/callback
DHAN_CLIENT_ID=
BROKER_TOKEN_STORAGE=supabase
BROKER_ENCRYPTION_SECRET=

# Approved broker partner links and server-side click storage.
DHAN_AFFILIATE_URL=
UPSTOX_AFFILIATE_URL=
ANGEL_AFFILIATE_URL=
ZERODHA_AFFILIATE_URL=
AFFILIATE_TRACKING_ENABLED=false
SUPABASE_AFFILIATE_CLICKS_TABLE=affiliate_clicks

# Advertising and sponsor placements. IDs are runtime Worker configuration, never hardcoded in frontend source.
ADS_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_LEADERBOARD=
ADSENSE_SLOT_RECTANGLE=
ADSENSE_SLOT_IN_FEED=
SPONSOR_MODE=placeholder
