    "activeOnImport": false,
    "globalDisableSwitch": "STOCKPRO_AUTOMATION_KILL_SWITCH",
    "workflowDisableSwitch": "STOCKPRO_WF_WEEKLY_SEO_REPORT_ENABLED",
    "testModeSwitch": "STOCKPRO_AUTOMATION_TEST_MODE",
    "failurePath": [
      "bounded retry on idempotent fixed adapter",
      "body-free failure audit",
      "encrypted dead letter after exhaustion",
      "human escalation"
    ],
    "retryPolicy": {
      "maxTries": 3,
      "waitBetweenTriesMs": 2000,
      "retryOnly": [
        "timeout",
        "connection failure",
        "HTTP 429",
        "HTTP 5xx"
      ],
      "neverRetry": [
        "validation",
        "authentication",
        "authorization",
        "other HTTP 4xx"
      ]
    },
    "deadLetter": {
      "retentionDays": 14,
      "encrypted": true,
      "adapterReferenceOnly": true
    },
    "audit": {
      "retentionDays": 365,
      "bodyFree": true,
      "events": [
        "disabled",
        "test_suppressed",
        "success",
        "failure",
        "retry_exhausted"
      ]
    },
    "allowedInputFields": [],
    "allowedActions": [
      "read Search Console aggregates when connected",
      "check indexed pages and sitemap",
      "read Core Web Vitals and broken links",
      "prepare operator report"
    ],
    "forbiddenData": [
      "authorization headers, cookies, sessions, tokens, secrets, passwords, PINs, OTPs, or TOTP values",
      "broker credentials, holdings, portfolio values, orders, trades, payment or card data",
      "raw private request bodies, raw support text, or user financial data"
    ],
    "forbiddenActions": [
      "write/push code or merge a pull request/main",
      "deploy, roll back, mutate production, or delete user data",
      "enable payment, trade, or change broker credentials",
      "execute shell, SSH, file, or arbitrary code",
      "Never generate/publish low-quality articles, modify the site, auto-submit URLs, or include query-level personal data."
    ],
    "requiresOwnerApproval": true,
    "requiresSecurityApproval": true,
    "promptInjectionPolicy": "No user-submitted free text accepted."
  }
