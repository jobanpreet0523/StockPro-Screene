    "failurePath": [
      "bounded retry on idempotent fixed adapter",
      "body-free failure audit",
      "encrypted dead letter after exhaustion",
      "human escalation"
    ],
    "retryPolicy": {
      "maxTries": 3,
      "waitBetweenTriesMs": 2000,
      "retryOnly": [
        "timeout",
        "connection failure",
        "HTTP 429",
        "HTTP 5xx"
      ],
      "neverRetry": [
        "validation",
        "authentication",
        "authorization",
        "other HTTP 4xx"
      ]
    },
    "deadLetter": {
      "retentionDays": 14,
      "encrypted": true,
      "adapterReferenceOnly": true
    },
    "audit": {
      "retentionDays": 365,
      "bodyFree": true,
      "events": [
        "disabled",
        "test_suppressed",
        "success",
        "failure",
        "retry_exhausted"
      ]
    },
    "allowedInputFields": [
      "version",
      "workflow",
      "eventId",
      "idempotencyKey",
      "occurredAt",
      "receivedAt",
      "testMode",
      "traceId",
      "payload.deploymentReference",
      "payload.commitSha",
      "payload.environment",
      "payload.deploymentUrlAlias"
    ],
    "allowedActions": [
      "run fixed safe GET/HEAD route checks",
      "verify fixed readiness/status contract",
      "prepare pass/fail report",
      "open issue when checks fail"
    ],
    "forbiddenData": [
      "authorization headers, cookies, sessions, tokens, secrets, passwords, PINs, OTPs, or TOTP values",
      "broker credentials, holdings, portfolio values, orders, trades, payment or card data",
      "raw private request bodies, raw support text, or user financial data"
    ],
    "forbiddenActions": [
      "write/push code or merge a pull request/main",
      "deploy, roll back, mutate production, or delete user data",
      "enable payment, trade, or change broker credentials",
      "execute shell, SSH, file, or arbitrary code",
      "Never merge, deploy, roll back, mutate configuration, purge data, or equate deployment success with readiness."
    ],
    "requiresOwnerApproval": true,
    "requiresSecurityApproval": true,
    "promptInjectionPolicy": "No user-submitted free text accepted."
  }
