# Copy to the automation host only. Never place real values in StockPro or Git.
N8N_IMAGE=n8nio/n8n:2.4.6
N8N_HOST=automation.internal.example
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
N8N_USER_MANAGEMENT_JWT_SECRET=replace-with-a-separate-random-secret
N8N_EDITOR_BASE_URL=https://automation-admin.internal.example/
WEBHOOK_URL=https://automation-ingress.internal.example/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-unique-database-password

# Ingress values live only in the gateway/secret manager, not in workflow JSON.
STOCKPRO_AUTOMATION_HMAC_SECRET=replace-with-a-unique-random-secret
STOCKPRO_AUTOMATION_INTERNAL_TOKEN=replace-with-a-separate-random-token
STOCKPRO_AUTOMATION_ENABLED=false
STOCKPRO_AUTOMATION_TEST_MODE=true
STOCKPRO_AUTOMATION_KILL_SWITCH=true
STOCKPRO_AUTOMATION_MAX_SKEW_SECONDS=300
STOCKPRO_AUTOMATION_REPLAY_TTL_SECONDS=900
STOCKPRO_AUTOMATION_RATE_LIMIT_PER_MINUTE=30

# Add only narrowly scoped credentials to the n8n credential store after approval.
# Never add broker tokens, holdings, portfolio values, payment credentials, or user secrets.
