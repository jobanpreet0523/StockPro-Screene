{
  "name": "stockpro-screener",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "security:scan": "node scripts/security-scan.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "build": "vite build && npx esbuild src/_worker.js --bundle --format=esm --outfile=dist/_worker.js --platform=browser --minify --conditions=worker",
    "ci": "npm run security:scan && npm run typecheck && npm run build && npm run verify:launch",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test tests/accessibility.spec.ts --project=chromium",
    "audit:lighthouse": "lhci autorun",
    "analyze:bundle": "ANALYZE_BUNDLE=true vite build",
    "quality:deps": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^5.0.4",
    "algoliasearch": "^5.55.2",
    "firebase": "^12.14.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.399.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-instantsearch": "^7.39.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "resend": "^6.17.2",
    "robots-parser": "^3.0.1",
    "sitemap": "^9.0.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "lighthouse": "^13.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
