{
  "name": "stockpro-screener",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "security:scan": "node scripts/security-scan.mjs",
    "test:security-invariants": "node scripts/security-invariants.test.mjs && node scripts/security-scan.test.mjs",
    "verify:supabase-rls": "node scripts/verify-supabase-rls.mjs",
    "verify:n8n-contracts": "node scripts/verify-n8n-contracts.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:landing-links": "node scripts/verify-landing-links.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:sitemap": "node scripts/validate-sitemap.mjs",
    "seo:sitemap:production": "node scripts/verify-production-sitemap.mjs",
    "build": "vite build --configLoader runner",
    "ci": "npm run typecheck && npm run security:scan && npm run test:security-invariants && npm run verify:plugin-readiness && npm run verify:n8n-contracts && npm run verify:agents && npm run build && node scripts/check-landing-bundle-budget.mjs && npm run test:landing-3d && npm run verify:launch && npm run smoke:routes && npm run smoke:landing-links && npm run seo:audit && npm run seo:sitemap && npm run quality:deps",
    "preview": "vite preview --configLoader runner",
    "test:e2e": "playwright test tests/stockpro-smoke.spec.ts tests/production-readiness.spec.ts tests/landing-product-experience.spec.ts tests/landing-3d.spec.ts tests/broker-integration.spec.ts tests/sentry-regression.spec.ts --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test tests/accessibility.spec.ts --project=chromium",
    "test:landing-3d": "playwright test tests/landing-3d.spec.ts tests/landing-3d-visual.spec.ts tests/landing-3d-lifecycle.spec.ts tests/landing-3d-mobile.spec.ts tests/landing-3d-reduced-motion.spec.ts tests/landing-3d-fallback.spec.ts tests/landing-3d-interactions.spec.ts tests/landing-3d-performance.spec.ts tests/landing-visual-regression.spec.ts --project=chromium",
    "test:visual": "playwright test tests/landing-3d-visual.spec.ts tests/landing-visual-regression.spec.ts --project=chromium",
    "verify:webgl": "playwright test tests/landing-3d-fallback.spec.ts tests/landing-3d-lifecycle.spec.ts --project=chromium",
    "verify:scene-disposal": "playwright test tests/landing-3d-lifecycle.spec.ts --project=chromium",
    "audit:lighthouse": "lhci autorun",
    "audit:lighthouse:summary": "node scripts/summarize-lighthouse.mjs",
    "analyze:bundle": "vite build --configLoader runner && node scripts/check-landing-bundle-budget.mjs",
    "quality:deps": "npm audit --omit=dev --audit-level=moderate",
    "verify:plugin-readiness": "node scripts/verify-plugin-readiness.mjs",
    "verify:agent-registry": "node scripts/agents/validate-agent-registry.mjs",
    "verify:agent-permissions": "node scripts/agents/validate-agent-permissions.mjs",
    "verify:agent-tasks": "node scripts/agents/validate-agent-task.mjs",
    "test:agent-validators": "node --test scripts/agents/validators.test.mjs",
    "verify:agents": "npm run verify:agent-registry && npm run verify:agent-permissions && npm run verify:agent-tasks && npm run test:agent-validators",
    "generate:agent-dashboard": "node scripts/agents/generate-agent-dashboard.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^5.0.4",
    "three": "^0.185.1",
    "algoliasearch": "^5.55.2",
    "firebase": "^12.14.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.399.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-instantsearch": "^7.39.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "resend": "^6.17.2",
    "robots-parser": "^3.0.1",
    "sitemap": "^9.0.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "lighthouse": "^13.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
